# ===== Produksi (Coolify): isi di tab Environment Variables =====
DB_ROOT_PASSWORD=ganti_root_password_kuat
DB_PASSWORD=ganti_password_app_kuat
JWT_SECRET=ganti_dengan_string_acak_minimal_32_karakter
# Midtrans: pakai server key sandbox (SB-Mid-server-...) atau production.
# Jangan commit file .env. Simpan di Coolify sebagai environment variable.
MIDTRANS_SERVER_KEY=SB-Mid-server-ganti_dengan_server_key
MIDTRANS_ENV=sandbox

# ===== Pengembangan lokal (backend dijalankan dengan cargo run) =====
# DATABASE_URL=mysql://toko:toko_secret@127.0.0.1:3306/toko_online
# BIND_ADDR=127.0.0.1:8080
# CORS_ORIGIN=http://localhost:5173
# FRONTEND_URL=http://localhost:5173
# COOKIE_SECURE=false
